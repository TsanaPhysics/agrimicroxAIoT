% ==========================================================
% Code listings (for bioinformatic/modelling python code)
% ==========================================================
\usepackage{listings}

\definecolor{CodeBgGray}{HTML}{F9FBF9}
\definecolor{CodeFgBlack}{HTML}{333333}
\definecolor{CodeKeyword}{HTML}{2E7D32}
\definecolor{CodeString}{HTML}{795548}
\definecolor{CodeComment}{HTML}{757575}
\definecolor{CodeNumber}{HTML}{EF6C00}

\lstset{
    language=Python,
    backgroundcolor=\color{CodeBgGray},
    basicstyle=\ttfamily\small\color{CodeFgBlack},
    commentstyle=\itshape\color{CodeComment},
    keywordstyle=\bfseries\color{CodeKeyword},
    stringstyle=\color{CodeString},
    numberstyle=\tiny\color{CodeComment},
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=8pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    frame=single,
    framesep=8pt,
    rulecolor=\color{agriGrayLine},
    framerule=1pt,
    frameround=tttt,
    xleftmargin=10pt,
    xrightmargin=4pt,
    aboveskip=10pt,
    belowskip=10pt
}

% Caption styling
\usepackage{caption}
\captionsetup{labelsep=space, labelfont=bf}
\captionsetup[lstlisting]{font={sf,footnotesize,color=agriGreen!70}, labelfont=bf, singlelinecheck=false, justification=raggedright, labelsep=period}
\renewcommand{\lstlistingname}{โค้ด}

