% Key Concept box (green)
\newtcolorbox{keyconcept}[1][แนวคิดสำคัญ]{
    enhanced, breakable,
    colback=agriGrayBox, colframe=agriGreen,
    boxrule=0.6pt, arc=3pt, left=10pt, right=10pt, top=8pt, bottom=8pt,
    fonttitle=\displayfont\bfseries\color{white},
    coltitle=white,
    attach boxed title to top left={yshift=-2mm, xshift=8pt},
    boxed title style={colback=agriGreen, arc=2pt, boxrule=0pt},
    title={#1}
}

