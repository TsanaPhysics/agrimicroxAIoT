\ProvidesPackage{agri_style}[2026/06/22 Commercial Style for Agricultural Microbiology]

% ==========================================================
% MicroBio Series — Commercial 6x9" E-book Style (Book 2)
% จุลชีววิทยาการเกษตร (Agricultural Microbiology)
% มหาวิทยาลัยราชภัฏรำไพพรรณี
% ==========================================================

% ---------- 1. Page geometry (Standard Academic B5: 176 x 250 mm) ----------
\usepackage[
    paperwidth=176mm,
    paperheight=250mm,
    top=24mm,
    bottom=24mm,
    inner=25mm,
    outer=20mm,
    headsep=8mm,
    footskip=12mm
]{geometry}
\setlength{\headheight}{14.5pt}

% ---------- 2. Fonts (Thai) ----------
\usepackage{fontspec}
\usepackage{polyglossia}
\setdefaultlanguage{thai}
\setotherlanguage{english}

% Thai Caption Localization
\gappto\captionsthai{%
    \renewcommand{\contentsname}{สารบัญ}%
    \renewcommand{\listfigurename}{สารบัญภาพ}%
    \renewcommand{\listtablename}{สารบัญตาราง}%
    \renewcommand{\bibname}{เอกสารอ้างอิงและบรรณานุกรม}%
    \renewcommand{\indexname}{ดัชนีคำค้นและศัพท์วิชาการ (Subject Index)}%
    \renewcommand{\figurename}{ภาพที่}%
    \renewcommand{\tablename}{ตารางที่}%
    \renewcommand{\appendixname}{ภาคผนวก}%
}

% Body: Sarabun (readable for Thai academic text)
\setmainfont{Sarabun}[
    UprightFont = * Regular,
    BoldFont = * Bold,
    ItalicFont = * Italic,
    BoldItalicFont = * Bold Italic,
    Scale = 1.0
]

\newfontfamily\thaifont{Sarabun}[Script=Thai,
    UprightFont = * Regular,
    BoldFont = * Bold,
    ItalicFont = * Italic,
    BoldItalicFont = * Bold Italic,
    Scale = 1.0
]

\newfontfamily\thaifontsf{Sarabun}[Script=Thai,
    UprightFont = * Regular,
    BoldFont = * Bold
]

\newfontfamily\thaifonttt{Sarabun}[Script=Thai,
    UprightFont = * Regular,
    BoldFont = * Bold,
    Scale = 0.9
]

% Display / headings: Use Sarabun
\newfontfamily\displayfont{Sarabun}[
    UprightFont = * Regular,
    BoldFont = * Bold,
    Scale = 1.0
]

% Sans family
\setsansfont{Sarabun}[
    UprightFont = * Regular,
    BoldFont = * Bold
]

% Typewriter family (for listings with Thai)
\setmonofont{Sarabun}[
    UprightFont = * Regular,
    BoldFont = * Bold,
    Scale = 0.9
]

\linespread{1.25}
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt plus 2pt minus 1pt}

% Improve justification
\tolerance=2000
\emergencystretch=3em
\hbadness=10000
\clubpenalty=10000
\widowpenalty=10000

% Enable Thai line breaking
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.5pt

% ---------- 3. Math & Biology ----------
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{amsfonts}
\usepackage{bm}
\usepackage{mathtools}
\usepackage{siunitx}

% ---------- 4. Colors (Agricultural Microbiology palette) ----------
\usepackage{xcolor}
\definecolor{agriGreen}{HTML}{2E7D32}    % Deep Forest Leaf Green (primary)
\definecolor{agriMidGreen}{HTML}{388E3C} % Mid Green (subheadings)
\definecolor{agriBrown}{HTML}{8D6E63}    % Clay/Earth Brown (accent/headers)
\definecolor{agriGold}{HTML}{FFB300}     % Golden Yellow (highlights)
\definecolor{agriInk}{HTML}{1A1A1A}      % Body text
\definecolor{agriGrayBox}{HTML}{F1F8E9}  % Very light green-gray box background
\definecolor{agriGrayLine}{HTML}{C5E1A5} % Light border line
\definecolor{agriRed}{HTML}{C62828}      % Pathogen warning
\definecolor{agriPurple}{HTML}{6A1B9A}   % Lab protocol
\definecolor{agriBlue}{HTML}{0288D1}     % Insight/Think blue
\color{agriInk}

% ---------- 5. Graphics, boxes, layout ----------
\usepackage{graphicx}
\usepackage[most]{tcolorbox}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\setlist{leftmargin=1.4em, itemsep=2pt, topsep=4pt}

% ---------- 6. Hyperlinks ----------

% ---------- TikZ & Graphing Libraries ----------
\usepackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, shapes.geometric, decorations.pathmorphing, backgrounds, fit, patterns}

% ---------- Subject Indexing (imakeidx) ----------
\usepackage{imakeidx}
\makeindex[columns=2, title={ดัชนีคำค้นและศัพท์วิชาการ (Subject Index)}, intoc]

\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=agriGreen,
    urlcolor=agriBrown,
    citecolor=agriGreen,
    pdftitle={จุลชีววิทยาการเกษตรและเทคโนโลยี AIoT},
    pdfauthor={ชีวะ ทัศนา, จิรภัทร จันทมาลี},
    pdfsubject={Agricultural Microbiology and AIoT Technology}
}

% ==========================================================
% Chapter & section title design
% ==========================================================
\titleformat{\chapter}[display]
    {\displayfont\bfseries\color{agriGreen}}
    {\hfill\fontsize{84}{84}\selectfont\color{agriBrown!50!agriGreen}\thechapter}
    {6pt}
    {\Huge\filright}
    [\vspace{4pt}{\color{agriBrown}\titlerule[2.5pt]}]
\titlespacing*{\chapter}{0pt}{10pt}{28pt}

\titleformat{\section}
    {\displayfont\bfseries\Large\color{agriGreen}}
    {\thesection}{0.6em}{}
    [\vspace{2pt}{\color{agriGrayLine}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{16pt}{6pt}

\titleformat{\subsection}
    {\displayfont\bfseries\large\color{agriMidGreen}}
    {\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

\titleformat{\subsubsection}
    {\displayfont\bfseries\normalsize\color{agriBrown!80!black}}
    {}{0em}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{3pt}

\titleformat{\paragraph}[runin]
    {\bfseries\color{agriMidGreen}}
    {}{0em}{}[\;]

% ==========================================================
% Headers & footers
% ==========================================================
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\displayfont\small\color{agriGreen!70}\thepage}
\fancyhead[LE]{\displayfont\footnotesize\color{agriGreen!55}\leftmark}
\fancyhead[RO]{\displayfont\footnotesize\color{agriGreen!55}จุลชีววิทยาการเกษตรและเทคโนโลยี AIoT}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\displayfont\small\color{agriGreen!70}\thepage}
}

